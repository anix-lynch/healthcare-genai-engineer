  "_meta": {
    "purpose": "Labelled ER-capacity scenarios for the Bed Ops action-agent eval. This is a CLINICAL-PROTOCOL-CONFORMANCE eval, not an LLM-reasoning eval: the agent (decide_bed_disposition / plan_agent_collaboration) is deterministic by design, so we assert its coded capacity protocol against INDEPENDENT clinical labels across many ER states.",
    "labeling_rule": "expected_disposition and expect_bed_ops_triggered are labelled from clinical intent (see docs/agent_eval_design.md rubric), NOT copied from the agent's output. Where the coded thresholds disagree with clinical intent at a boundary, the scenario is left as a real MISS and classified in the failure taxonomy — it is NOT rigged to 1.0 and the production logic is NOT patched to chase a green number.",
    "honesty_invariant": "A perfect score here would be evidence of circular labelling. The committed baseline carries real, documented boundary misses.",
    "disposition_space": ["assign_bed", "board_ed", "hold_observation", "divert", "discharge_plan"],
    "fields": "available_beds, occupancy_pct, queue_length, triage, predicted_los_hours, bed_pressure_risk → expected_disposition, expect_bed_ops_triggered (+ category, label_rationale on misses/notable cases)"
  },
